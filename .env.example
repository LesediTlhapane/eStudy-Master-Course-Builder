# GEMINI_API_KEY: Server-side API key for Google Gemini AI models (gemini-4-hydrogen, gemini-3.1-flash-lite).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Primary API key for Groq AI API calls (Llama, GPT-OSS, Qwen, etc.).
# You can also provide multiple comma-separated keys in GROQ_API_KEY (e.g., "gsk_key1,gsk_key2").
GROQ_API_KEY="MY_GROQ_API_KEY"

# GROQ_API_KEY_2 / GROQ_BACKUP_API_KEY: Optional second/backup Groq API key.
# Automatically used as a failover when the primary GROQ_API_KEY reaches a rate limit (429 / TPM).
GROQ_API_KEY_2="MY_SECOND_GROQ_API_KEY"
GROQ_BACKUP_API_KEY="MY_BACKUP_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
